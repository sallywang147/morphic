module Core = file "lib/core/core.mor"
  expose {
    module Array expose { get, set },
    module Io expose { writeln },
    module Option expose { Option { Some, None } },
    module String expose {string_to_int, string_to_nat, int_to_string,equal },
  }

module Bench = file "lib/bench_common.mor" with { Core }
  expose { repeat }


test_simple(n: Int): Int =
  let a = [1, 2, 3] in
  let b = a in
  let a_prime = set(a, 0, 4) in
  let b_prime = set(b, 0, 5) in
  
  // Check expected values and return a single integer result
  if get(a, 0) = 1 {
    1  // Indicating success
  } else {
    0  // Indicating failure
  }

proc main(): () =
  let iter_str = do input() in
  let benchmark_name = do input() in
  let test_fn = if equal(benchmark_name, "simple") {
    test_simple
  } else {
    \_ -> 0
  } in

  match (string_to_int(iter_str), string_to_int(do input())) {
    (Some(iters), Some(_)) ->
      match repeat(iters, \() -> test_fn(1)) {
        Some(n) -> do writeln(int_to_string(n)),
        None -> (),
      },
    _ ->
     do writeln("Please enter valid iteration count."),
  }

  